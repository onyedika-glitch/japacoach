# Copy to api/.env on the server. Values marked CHANGE must match the root .env.
# Tip: copy the DB_* lines from your local api/.env (they already point at Supabase).
APP_NAME="Japa Coach"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://japacoach.example.com
FRONTEND_URL=https://japacoach.example.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Supabase: Project Settings → Database → Connection string → "Session pooler".
# Use port 5432 (session mode). Port 6543 (transaction mode) breaks Laravel's prepared statements.
DB_CONNECTION=pgsql
DB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=japacoach.example.com
SANCTUM_STATEFUL_DOMAINS=japacoach.example.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=hello@japacoach.example.com
MAIL_FROM_NAME="Japa Coach"
RESEND_API_KEY=

# Bachs (use sk_sandbox_ keys to test)
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_CURRENCY=NGN
PLAN_WEEKLY_PRICE=1500
PLAN_MONTHLY_PRICE=4000
PLAN_SPRINT_PRICE=10000

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

SPEECH_SERVICE_URL=http://speech:8100
# CHANGE: same as SPEECH_SERVICE_TOKEN in the root .env
SPEECH_SERVICE_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://japacoach.example.com/auth/google/callback
