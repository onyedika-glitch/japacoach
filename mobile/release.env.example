# Build settings for scripts/shorebird.sh. Copy to release.env (gitignored) and fill in.
# Never patch with different values than the release you are patching.

# Defaults are built into the app; only set these to override.
# API_URL=https://japacoach.com
# GOOGLE_SERVER_CLIENT_ID=671451700757-ekv0pamep93sdablqohkqada5385mis2.apps.googleusercontent.com

# Firebase console → Project settings → General → Your apps (Android, com.japacoach.app). Empty = push off.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
