{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 22MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "microphone=(self), camera=()"
	}

	# Generated audio (listening tests, examiner questions) from Laravel's public disk.
	handle_path /storage/* {
		root * /var/www/api/storage/app/public
		header Cache-Control "public, max-age=604800"
		file_server
	}

	@laravel path /api/* /sanctum/* /auth/google* /payment/* /up /sitemap.xml /robots.txt
	handle @laravel {
		root * /var/www/api/public
		php_fastcgi app:9000 {
			read_timeout 200s
		}
	}

	handle {
		root * /srv/frontend
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
